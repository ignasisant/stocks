# Build-context hygiene. HF Spaces builds from the pushed git repo, where
# .gitignore already keeps personal data out; this covers local docker builds,
# which see the working tree (private ledgers, secrets, caches).
.git
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache

# Secrets — never bake into an image. The rotate script leaves
# secrets.toml.bak.<ts> copies beside the live file, each holding the keys
# it replaced; the deploy/ folder keeps its own env and secrets for compose.
.streamlit/secrets.toml
.streamlit/secrets.toml.bak*
.streamlit/*.bak*
**/.env
**/secrets.toml*
.notify_secrets.env
infra/**/*.tfstate*
infra/**/terraform.tfvars

# Personal data + runtime caches (restored from R2 / refetched at runtime)
data/users/
data/statements/
data/*.csv
data/*.parquet
data/portfolio.db*
data/prefs.json
data/chat.json
data/fx_history.json
data/last_import.json
watchlist.yaml
src/stocks/web/static/logos/
# Owner-account state and observability that names accounts
data/chat_memory.db
data/daily_action.json
data/logs/
data/imports/
data/memo/
data/feedback/
data/tg_updates/

# Not needed at runtime
notebooks/
tests/
# inlined into src/stocks/baml_client by baml-cli generate
baml_src/
infra/
.github/
.claude/
.agents/
