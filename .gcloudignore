# Keep the Cloud Run source upload free of local secrets and junk.
# The #!include pulls in .gitignore, which already covers secrets.toml,
# its .bak* copies, portfolio.db, prefs.json and the statements folder.
#!include:.gitignore
.git
.gcloudignore
.venv
__pycache__/
# belt and braces — these must never reach the build context
.streamlit/secrets.toml
.streamlit/secrets.toml.bak*
deploy/.env
deploy/secrets.toml

# Terraform: the nested infra/.gitignore hides state and tfvars from git, but
# gcloud honours only the root .gitignore through #!include — so without these
# lines every source deploy shipped terraform.tfstate (every secret in
# plaintext) and ~300 MB of provider binaries to the run-sources bucket.
infra/
**/*.tfstate
**/*.tfstate.backup
**/terraform.tfvars
**/.terraform/
.notify_secrets.env
