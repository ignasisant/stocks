{
  "name": "topstocks-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The app shell and its pages, rebuilt off the HTTP API. See frontend/README.md.",
  "scripts": {
    "dev": "vite",
    "build": "prettier --check src && tsc --noEmit && vitest run && vite build && vite build -c vite.mcp.config.ts",
    "preview": "vite preview",
    "format": "prettier --write src index.html",
    "test": "vitest run",
    "knip": "knip"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@ag-ui/core": "^1.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.38.0",
    "preact": "^10.29.8",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
