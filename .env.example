# yfinance needs no key. Fill these only if you later add these providers.
ALPHAVANTAGE_API_KEY=

# Finnhub (free key at finnhub.io): US quotes while Yahoo throttles us. Same as
# [finnhub] api_key in secrets.toml; unset means Yahoo only.
FINNHUB_API_KEY=

# Twelve Data (free key at twelvedata.com): daily closes for US names Yahoo did
# not answer (8 requests/min, 800/day). Same as [twelvedata] api_key in
# secrets.toml; unset means Yahoo only.
TWELVEDATA_API_KEY=

# OpenFIGI (optional; free key at openfigi.com/api): ISIN -> listings for the
# importer. Keyless works at 25 requests a minute. Same as [openfigi] api_key.
OPENFIGI_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (free, no key).
EDGAR_USER_AGENT="stocks-toolkit your-email@example.com"

# Financial Modeling Prep: fallback fundamentals for a non-US filer EDGAR has
# no CIK for (P/E-vs-history, insider/comps sourcing). Sign up at
# financialmodelingprep.com/developer/docs; unset means "EDGAR only". A free
# key still will not reach a genuinely foreign symbol (KRX, an OTC ADR) —
# that's the paid plan's "international" coverage, not this app's own limit.
FMP_API_KEY=

# --- Alert delivery (stocks alerts --deliver). Unset channels are skipped. ---
# Per-user notifications go out as Web Push (secrets.toml [webpush]
# private_key); the email channel below is only the single-user CLI's.

# Multi-user notification cron (GitHub Actions) — set as repo secrets, not here:
#   STOCKS_STORAGE_* (bucket creds), WEBPUSH_PRIVATE_KEY (= [webpush] private_key),
#   CHAT_ENC_KEY (= secrets.toml [chat] enc_key, for BYOK digest highlights),
#   FREE_LLM_GROQ / FREE_LLM_CEREBRAS / FREE_LLM_OPENROUTER (free-chain fallback).

# Email over SMTP (e.g. Gmail app password). ALERT_EMAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
